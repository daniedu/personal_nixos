# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# PICO-8 is commercial software: the extracted archive is not redistributable
# and never enters this repository. Nix builds it from the store copy instead
# (see packages/pico-8.nix).
assets/pico-8/
